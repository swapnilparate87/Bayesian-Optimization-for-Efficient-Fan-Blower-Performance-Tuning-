# ── Base image ──
FROM python:3.12-slim

# ── Set working directory ──
WORKDIR /app

# ── Install system dependencies ──
RUN apt-get update && apt-get install -y \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# ── Copy requirements first (for Docker layer caching) ──
COPY requirements-api.txt .

# ── Install Python dependencies ──
RUN pip install --no-cache-dir -r requirements-api.txt

# ── Copy app files ──
COPY fanblower_app/main.py fanblower_app/main.py
COPY fanblower_app/feature_extractor.py fanblower_app/feature_extractor.py
COPY fanblower_app/__init__.py fanblower_app/__init__.py
COPY models/ models/

# ── Expose port ──
EXPOSE 8000

# ── Run FastAPI ──
CMD ["uvicorn", "fanblower_app.main:app", "--host", "0.0.0.0", "--port", "8000"]
